# LLM Providers (set the one you use). Never commit the real .env — it's git-ignored.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=

# Apex 50K v2.6 strategy overrides (optional — defaults match apex_strategy.py)
# TRADINGAGENTS_LLM_PROVIDER=minimax
# TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M3
# TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M2.7-highspeed

# Notifications (optional — set BOTH for each channel you want to use; both are no-op if missing)
# Discord: channel Settings → Integrations → Webhooks → New Webhook → Copy URL
# DISCORD_WEBHOOK_URL=

# Telegram: talk to @BotFather, get bot token; message the bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Set to 1 to log notifications to stdout when no channels are configured (dev)
# APEX_NOTIFY_VERBOSE=0

